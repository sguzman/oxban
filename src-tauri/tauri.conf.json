{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oxban",
  "version": "0.1.0",
  "identifier": "com.example.oxban",
  "build": {
    "beforeDevCommand": "bash scripts/trunk-wrapper.sh serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/trunk-wrapper.sh build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Oxban",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
